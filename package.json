{
  "name": "famifinanzas",
  "version": "1.0.0",
  "description": "FamiFinanzas migrado a TypeScript: API REST + JWT + Swagger + EJS con frontend en TS",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "clean": "node -e \"for (const d of ['dist','public/js']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "prestart": "npm run build",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "seed": "npm run build:server && node dist/src/db/seed.js",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"dist/tests/**\" \"dist/tests/**/*.test.js\"",
    "bench": "npm run build:server && node dist/scripts/benchmark.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3"
  }
}
